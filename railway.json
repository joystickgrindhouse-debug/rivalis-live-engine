{
  "$schema": "https://railway.app/railway.schema.json",
  "build": {
    "builder": "nixpacks",
    "buildCommand": "cd live-server && npm install"
  },
  "deploy": {
    "numReplicas": 1,
    "startCommand": "cd live-server && npm start",
    "restartPolicyMaxRetries": 5,
    "restartPolicyWindowMs": 60000
  }
}
