# Server Configuration
PORT=8080
NODE_ENV=production

# Firebase Admin SDK Configuration
# Generate JSON and pass as stringified JSON
FIREBASE_SERVICE_ACCOUNT={"type":"service_account","project_id":"your-project-id","private_key_id":"...","private_key":"-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----","client_email":"firebase-adminsdk@your-project.iam.gserviceaccount.com","client_id":"...","auth_uri":"https://accounts.google.com/o/oauth2/auth","token_uri":"https://oauth2.googleapis.com/token","auth_provider_x509_cert_url":"https://www.googleapis.com/oauth2/v1/certs","client_x509_cert_url":"..."}

# Discord Bot Integration
DISCORD_BOT_URL=http://localhost:5000

# Logging
LOG_LEVEL=info
