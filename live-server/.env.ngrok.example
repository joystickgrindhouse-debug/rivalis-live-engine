# Live Server Environment Variables

# Server Configuration
PORT=8080
NODE_ENV=production

# ============ FOR REMOTE PLAYERS (NGROK) ============
# After running 'ngrok http 8080', copy the URL here
# Example: https://abc-123-def.ngrok.io
LIVE_SERVER_URL=https://YOUR_NGROK_URL_HERE

# ============ HUB CONNECTION ============
HUB_API_URL=https://your-hub-project.vercel.app
HUB_API_SECRET=a7f3d8c9e2b1f4a6d8c7e9f2a3b5d7e8c9f1a2b3c4d5e6f7a8b9c0d1e2f3a4b5

# Firebase Admin SDK Configuration
# Generate JSON from Firebase Console → Service Accounts → Generate New Private Key
# Keep as stringified JSON on one line
FIREBASE_SERVICE_ACCOUNT={"type":"service_account","project_id":"your-project-id","private_key_id":"...","private_key":"-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----","client_email":"firebase-adminsdk@your-project.iam.gserviceaccount.com","client_id":"...","auth_uri":"https://accounts.google.com/o/oauth2/auth","token_uri":"https://oauth2.googleapis.com/token","auth_provider_x509_cert_url":"https://www.googleapis.com/oauth2/v1/certs","client_x509_cert_url":"..."}

# Discord Bot Integration (optional)
DISCORD_BOT_URL=http://localhost:5000

# Logging
LOG_LEVEL=info
